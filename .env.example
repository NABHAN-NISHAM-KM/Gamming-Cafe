# Migrations (table owner)
DATABASE_URL=postgresql://arena_owner:arena_owner_dev@localhost:5432/arena

# Runtime API (RLS enforced)
APP_DATABASE_URL=postgresql://arena_api:arena_api_dev@localhost:5432/arena

# Super Admin service (BYPASSRLS — platform service only, never the tenant API)
PLATFORM_DATABASE_URL=postgresql://arena_platform_svc:arena_platform_dev@localhost:5432/arena

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=any
S3_SECRET_KEY=any

# Tests use their own database so they never touch your dev data
TEST_DATABASE_URL=postgresql://arena_owner:arena_owner_dev@localhost:5432/arena_test
TEST_APP_DATABASE_URL=postgresql://arena_api:arena_api_dev@localhost:5432/arena_test

# Customer app
# The address players open on their phones; the PCs show it as a "sign in with your phone" QR code.
CUSTOMER_APP_URL=http://localhost:5175
# Web push keys come from `npm run keys -w @arena/api` (without them, push notifications are off).

# Website (apps/website) — sales leads, demo calls, free trials
# LEADS_WEBHOOK_URL=https://hooks.slack.com/services/...   # new leads are also POSTed here (optional)
SALES_TIMEZONE=Asia/Dubai        # demo-call slots are offered Sun–Thu 10:00–17:30 in this zone
TRIAL_PLAN_CODE=PRO              # the plan a self-serve 14-day trial starts on
# Website server (serve.mjs): where it forwards /v1/public and /v1/app, and the public address for SEO links
PLATFORM_URL=http://localhost:4100
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
# SITE_URL=https://arenaos.example
