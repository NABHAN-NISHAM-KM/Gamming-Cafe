{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@arena/admin"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@arena/api"
      ],
      "port": 4000
    },
    {
      "name": "platform",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:platform",
        "-w",
        "@arena/api"
      ],
      "port": 4100
    },
    {
      "name": "shell",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@arena/shell"
      ],
      "port": 5174
    },
    {
      "name": "customer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@arena/customer"
      ],
      "port": 5175
    },
    {
      "name": "website",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/website/serve.mjs"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "demo-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/demo/scripts/stack.mjs",
        "api"
      ],
      "port": 4010
    },
    {
      "name": "demo-platform",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/demo/scripts/stack.mjs",
        "platform"
      ],
      "port": 4110
