// ── Product catalog, unified POS orders, bills, restaurant, KDS, tables ─────
// One Order model serves every sale channel: POS counter, in-seat shell
// ordering, waiter, QR table, web/app. Gaming time, memberships, top-ups,
// printing and tournament entries are Products too, so a customer gets ONE
// combined Bill ("2h gaming + burger + drink + printing").

enum ProductType {
  STOCK_ITEM // sold as-is from inventory (Red Bull can)
  RECIPE_ITEM // made in kitchen, deducts ingredients (Burger)
  COMBO
  SERVICE
  GAMING_TIME
  MEMBERSHIP
  WALLET_TOPUP
  PRINTING
  BOOKING_FEE
  TOURNAMENT_ENTRY
  GIFT_CARD
}

model ProductCategory {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  parentId       String?           @db.Uuid
  name           String
  imageUrl       String?
  sortOrder      Int               @default(0)
  showInShell    Boolean           @default(true)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  organization   Organization      @relation(fields: [organizationId], references: [id])
  parent         ProductCategory?  @relation("CategoryTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children       ProductCategory[] @relation("CategoryTree")
  products       Product[]

  @@unique([id, organizationId])
}

model Product {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  organizationId        String                 @db.Uuid
  categoryId            String                 @db.Uuid
  type                  ProductType
  sku                   String
  barcode               String?
  name                  String
  description           String?
  imageUrl              String?
  price                 Decimal                @db.Decimal(19, 4) // org default; ProductBranchPrice overrides
  currency              String                 @db.Char(3)
  taxAppliesTo          TaxAppliesTo           @default(ALL)
  inventoryItemId       String?                @db.Uuid // STOCK_ITEM → 1:1 stock item
  kitchenStationId      String?                @db.Uuid // default KDS routing
  prepTimeMinutes       Int?
  availableInShell      Boolean                @default(true)
  availableOnline       Boolean                @default(true)
  requiresAgeCheck      Boolean                @default(false)
  // Links for non-physical products
  pricingPackageId      String?                @db.Uuid // GAMING_TIME
  membershipTierId      String?                @db.Uuid // MEMBERSHIP
  isActive              Boolean                @default(true)
  sortOrder             Int                    @default(0)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  category              ProductCategory        @relation(fields: [categoryId, organizationId], references: [id, organizationId])
  inventoryItem         InventoryItem?         @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  kitchenStation        KitchenStation?        @relation(fields: [kitchenStationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pricingPackage        PricingPackage?        @relation(fields: [pricingPackageId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membershipTier        MembershipTier?        @relation(fields: [membershipTierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  comboItems            ComboItem[]            @relation("ComboParent")
  partOfCombos          ComboItem[]            @relation("ComboChild")
  productBranchPrices   ProductBranchPrice[]
  productModifierGroups ProductModifierGroup[]
  recipeLines           RecipeLine[]
  orderItems            OrderItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
  @@index([organizationId, barcode])
}

model ProductBranchPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  branchId       String   @db.Uuid
  price          Decimal? @db.Decimal(19, 4) // null = use product price
  isAvailable    Boolean  @default(true) // 86'd at this branch
  product        Product  @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch         Branch   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([organizationId])
}

model ModifierGroup {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  organizationId        String                 @db.Uuid
  name                  String // "Size", "Extra toppings", "Sugar level"
  minSelect             Int                    @default(0)
  maxSelect             Int                    @default(1)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  organization          Organization           @relation(fields: [organizationId], references: [id])
  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]

  @@unique([id, organizationId])
}

model Modifier {
  id              String         @id @default(uuid(7)) @db.Uuid
  organizationId  String         @db.Uuid
  groupId         String         @db.Uuid
  name            String
  priceDelta      Decimal        @default(0) @db.Decimal(19, 4)
  inventoryItemId String?        @db.Uuid
  inventoryQty    Decimal?       @db.Decimal(14, 4)
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  group           ModifierGroup  @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, groupId])
}

model ProductModifierGroup {
  organizationId  String        @db.Uuid
  productId       String        @db.Uuid
  modifierGroupId String        @db.Uuid
  sortOrder       Int           @default(0)
  product         Product       @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@index([organizationId])
}

model ComboItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  comboId        String  @db.Uuid
  productId      String  @db.Uuid
  quantity       Int     @default(1)
  combo          Product @relation("ComboParent", fields: [comboId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product        Product @relation("ComboChild", fields: [productId, organizationId], references: [id, organizationId])

  @@index([organizationId, comboId])
}

/// Bill-of-materials for RECIPE_ITEM products → automatic ingredient deduction.
model RecipeLine {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @db.Uuid
  productId       String        @db.Uuid
  inventoryItemId String        @db.Uuid
  quantity        Decimal       @db.Decimal(14, 4) // in the item's base unit
  wastePct        Decimal       @default(0) @db.Decimal(5, 2)
  product         Product       @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId])

  @@unique([productId, inventoryItemId])
  @@index([organizationId])
}

// ── Bills & orders ──

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  SETTLED
  VOID
}

/// The customer's tab. Aggregates gaming-session charges, extensions and all
/// orders placed during the visit. Settled by one or more Payments.
model Bill {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  branchId       String           @db.Uuid
  number         String // "DXB1-000123"
  customerId     String?          @db.Uuid
  tableId        String?          @db.Uuid
  status         BillStatus       @default(OPEN)
  subtotal       Decimal          @default(0) @db.Decimal(19, 4)
  discountTotal  Decimal          @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal          @default(0) @db.Decimal(19, 4)
  tipTotal       Decimal          @default(0) @db.Decimal(19, 4)
  total          Decimal          @default(0) @db.Decimal(19, 4)
  paidTotal      Decimal          @default(0) @db.Decimal(19, 4)
  currency       String           @db.Char(3)
  openedById     String?          @db.Uuid
  closedById     String?          @db.Uuid
  openedAt       DateTime         @default(now()) @db.Timestamptz(3)
  closedAt       DateTime?        @db.Timestamptz(3)
  version        Int              @default(0)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  branch         Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId])
  customer       Customer?        @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  table          RestaurantTable? @relation(fields: [tableId, organizationId], references: [id, organizationId], onDelete: Restrict)
  payments       Payment[]
  invoices       Invoice[]
  orders         Order[]
  gamingSessions GamingSession[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, branchId, status])
  @@index([organizationId, branchId, closedAt]) // sales reports
}

enum OrderChannel {
  POS
  SHELL // in-seat from the gaming PC
  WAITER
  QR_TABLE
  WEB
  MOBILE
  KIOSK
  SYSTEM // e.g. session billing
}

enum OrderType {
  DINE_IN
  GAMING_SEAT
  TAKEAWAY
  DELIVERY
  PICKUP
  COUNTER // non-food POS sale
}

enum OrderStatus {
  DRAFT
  PLACED
  ACCEPTED
  IN_PROGRESS
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentState {
  UNPAID
  PARTIALLY_PAID
  PAID
  ON_BILL // "add to session bill / pay at checkout"
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id                   String                @id @default(uuid(7)) @db.Uuid
  organizationId       String                @db.Uuid
  branchId             String                @db.Uuid
  number               String // short daily ticket number, e.g. "A1045"
  channel              OrderChannel
  type                 OrderType
  status               OrderStatus           @default(DRAFT)
  paymentState         PaymentState          @default(UNPAID)
  billId               String?               @db.Uuid
  customerId           String?               @db.Uuid
  deviceId             String?               @db.Uuid // deliver-to station for GAMING_SEAT
  gamingSessionId      String?               @db.Uuid
  tableId              String?               @db.Uuid
  employeeId           String?               @db.Uuid // cashier/waiter
  shiftId              String?               @db.Uuid
  deliverTo            String? // snapshot label "VIP-PC-12 · VIP Zone"
  subtotal             Decimal               @default(0) @db.Decimal(19, 4)
  discountTotal        Decimal               @default(0) @db.Decimal(19, 4)
  taxTotal             Decimal               @default(0) @db.Decimal(19, 4)
  tipTotal             Decimal               @default(0) @db.Decimal(19, 4)
  total                Decimal               @default(0) @db.Decimal(19, 4)
  currency             String                @db.Char(3)
  notes                String?
  placedAt             DateTime?             @db.Timestamptz(3)
  completedAt          DateTime?             @db.Timestamptz(3)
  cancelledAt          DateTime?             @db.Timestamptz(3)
  cancelReason         String?
  cancelledById        String?               @db.Uuid
  idempotencyKey       String?
  offlineOrigin        Boolean               @default(false)
  version              Int                   @default(0)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  branch               Branch                @relation(fields: [branchId, organizationId], references: [id, organizationId])
  bill                 Bill?                 @relation(fields: [billId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer             Customer?             @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  device               Device?               @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  gamingSession        GamingSession?        @relation(fields: [gamingSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  table                RestaurantTable?      @relation(fields: [tableId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employee             Employee?             @relation("OrderEmployee", fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cancelledBy          Employee?             @relation("OrderCancelledBy", fields: [cancelledById, organizationId], references: [id, organizationId], onDelete: Restrict)
  shift                Shift?                @relation(fields: [shiftId, organizationId], references: [id, organizationId], onDelete: Restrict)
  payments             Payment[]
  promotionRedemptions PromotionRedemption[]
  orderItems           OrderItem[]
  kitchenTickets       KitchenTicket[]

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, status, createdAt])
  @@index([organizationId, gamingSessionId])
  @@index([organizationId, billId])
}

enum OrderItemStatus {
  PENDING
  SENT_TO_KITCHEN
  PREPARING
  READY
  SERVED
  VOIDED
  REFUNDED
}

model OrderItem {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @db.Uuid
  orderId         String          @db.Uuid
  productId       String          @db.Uuid
  kitchenTicketId String?         @db.Uuid
  nameSnapshot    String
  productType     ProductType
  quantity        Decimal         @db.Decimal(14, 4) // decimal for weighed items / minutes
  unitPrice       Decimal         @db.Decimal(19, 4)
  modifiers       Json            @default("[]") // [{modifierId, name, priceDelta}]
  modifiersTotal  Decimal         @default(0) @db.Decimal(19, 4)
  discountAmount  Decimal         @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal         @default(0) @db.Decimal(19, 4)
  lineTotal       Decimal         @db.Decimal(19, 4)
  taxBreakdown    Json            @default("[]")
  promotionId     String?         @db.Uuid
  status          OrderItemStatus @default(PENDING)
  notes           String? // kitchen notes
  // Links for non-physical lines
  gamingSessionId String?         @db.Uuid
  bookingId       String?         @db.Uuid
  seatLabel       String? // split-bill by seat
  voidedById      String?         @db.Uuid
  voidReason      String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  order           Order           @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product         Product         @relation(fields: [productId, organizationId], references: [id, organizationId])
  kitchenTicket   KitchenTicket?  @relation(fields: [kitchenTicketId, organizationId], references: [id, organizationId], onDelete: Restrict)
  gamingSession   GamingSession?  @relation(fields: [gamingSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  booking         Booking?        @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, orderId])
  @@index([organizationId, productId, createdAt])
}

// ── Restaurant: kitchen & tables ──

model KitchenStation {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @db.Uuid
  branchId        String          @db.Uuid
  name            String // "Grill", "Bar", "Fryer"
  displayDeviceId String?         @db.Uuid // Device(kind=KDS_SCREEN)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  branch          Branch          @relation(fields: [branchId, organizationId], references: [id, organizationId])
  displayDevice   Device?         @relation("KdsDisplay", fields: [displayDeviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  products        Product[]
  kitchenTickets  KitchenTicket[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId])
}

enum KitchenTicketStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model KitchenTicket {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  branchId       String              @db.Uuid
  orderId        String              @db.Uuid
  stationId      String              @db.Uuid
  status         KitchenTicketStatus @default(NEW)
  priority       Int                 @default(0)
  deliverTo      String? // "VIP-PC-12", "Table 4", "Takeaway"
  customerLabel  String?
  notes          String?
  acceptedAt     DateTime?           @db.Timestamptz(3)
  startedAt      DateTime?           @db.Timestamptz(3)
  readyAt        DateTime?           @db.Timestamptz(3)
  servedAt       DateTime?           @db.Timestamptz(3)
  cancelledAt    DateTime?           @db.Timestamptz(3)
  bumpedById     String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  branch         Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId])
  order          Order               @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  station        KitchenStation      @relation(fields: [stationId, organizationId], references: [id, organizationId])
  orderItems     OrderItem[]

  @@unique([id, organizationId])
  @@index([organizationId, stationId, status])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  BILL_REQUESTED
  OUT_OF_SERVICE
}

model RestaurantTable {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @db.Uuid
  branchId         String            @db.Uuid
  zoneId           String?           @db.Uuid
  name             String // "T4", "Booth 2"
  seats            Int               @default(4)
  status           TableStatus       @default(AVAILABLE)
  shape            String            @default("rect")
  mapX             Int               @default(0)
  mapY             Int               @default(0)
  mapW             Int               @default(1)
  mapH             Int               @default(1)
  qrToken          String            @unique // rotating token for QR ordering
  mergedIntoId     String?           @db.Uuid
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  branch           Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId])
  zone             Zone?             @relation(fields: [zoneId, organizationId], references: [id, organizationId], onDelete: Restrict)
  mergedInto       RestaurantTable?  @relation("TableMerge", fields: [mergedIntoId, organizationId], references: [id, organizationId], onDelete: Restrict)
  mergedTables     RestaurantTable[] @relation("TableMerge")
  bookingResources BookingResource[]
  bills            Bill[]
  orders           Order[]

  @@unique([id, organizationId])
  @@unique([branchId, name])
}
