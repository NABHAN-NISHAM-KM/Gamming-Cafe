<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- ArenaOS station agent: Windows service (LocalSystem) that connects the PC
       to the branch, reports health and executes signed commands. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ArenaAgent</AssemblyName>
    <RootNamespace>Arena.Agent</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arena.Agent.Core\Arena.Agent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="install-agent.ps1;uninstall-agent.ps1;setup-player.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
